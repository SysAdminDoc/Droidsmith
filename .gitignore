# Node / Vite / React
node_modules/
dist/*
!dist/.gitkeep
!dist/index.html
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
**/*.rs.bk
Cargo.lock.bak

# Tauri build output
src-tauri/release/
src-tauri/debug/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.sample
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# HGFS dev-mirror staging
.dev-mirror/

# Secrets / env
.env
.env.local
.env.*.local

# Bundled platform-tools cache (downloaded on first run, do not commit)
src-tauri/resources/platform-tools/
src-tauri/resources/scrcpy/
src-tauri/binaries/

# Test artefacts
coverage/
playwright-report/
playwright/.cache/
test-results/
provenance/

# Public project tracking documents are durable repository state. Other
# markdown remains local-only so generated notes and private work do not get
# staged accidentally; GitHub intake uses YAML issue forms.
*.md
!README.md
!CHANGELOG.md
!RESEARCH.md
!ROADMAP.md
!.github/ISSUE_TEMPLATE/*.yml

# AI config
CLAUDE.md
CODEX_CHANGELOG.md
AGENTS.md
.claude/
.codex/
.ai/
PROJECT_CONTEXT.md
CONTINUATION_PROMPT.md
