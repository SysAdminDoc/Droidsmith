{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "3"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "device": {
      "$ref": "#/$defs/ProfileDeviceMatch",
      "default": {
        "require_serial_prefix": "",
        "require_manufacturer": "",
        "require_model": "",
        "require_android_min": null,
        "require_android_max": null
      }
    },
    "user": {
      "$ref": "#/$defs/ProfileUserTarget",
      "default": {
        "mode": "owner",
        "id": null
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileAction"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "actions"
  ],
  "$defs": {
    "ProfileDeviceMatch": {
      "type": "object",
      "properties": {
        "require_serial_prefix": {
          "type": "string",
          "default": ""
        },
        "require_manufacturer": {
          "type": "string",
          "default": ""
        },
        "require_model": {
          "type": "string",
          "default": ""
        },
        "require_android_min": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "require_android_max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ProfileUserTarget": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ProfileUserMode",
          "default": "owner"
        },
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ProfileUserMode": {
      "type": "string",
      "enum": [
        "owner",
        "current",
        "explicit"
      ]
    },
    "ProfileAction": {
      "description": "One step of a profile: either a concrete package, or — from schema v3 — a\npredicate resolved against the live inventory at plan time.\n\nExactly one of the two is set. They are separate fields rather than an\nenum because a v2 document must keep deserializing byte-for-byte, and\nbecause YAML with a tag discriminator is markedly worse to hand-author.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "package": {
          "description": "A concrete package id. Empty when `filter` is set.",
          "type": "string"
        },
        "filter": {
          "description": "A schema-v3 predicate over package attributes. Empty when `package` is\nset. See [`crate::profile_filter`] for the grammar.",
          "type": "string"
        },
        "note": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "ActionKind": {
      "oneOf": [
        {
          "description": "`pm suspend --user 0 <pkg>` — reversible with `pm unsuspend` and\nless destructive than disabling the package.",
          "type": "string",
          "const": "suspend"
        },
        {
          "description": "`pm unsuspend --user 0 <pkg>` — reverses Suspend.",
          "type": "string",
          "const": "unsuspend"
        },
        {
          "description": "`pm unstop --user 0 <pkg>` — clears Android's stopped bit. The\njournal inverse uses `am force-stop` only after verifying the package\nreturned to the unstopped state.",
          "type": "string",
          "const": "unstop"
        },
        {
          "description": "`pm hide --user 0 <pkg>` — hides a package for one Android user while\nretaining its APK and data.",
          "type": "string",
          "const": "hide"
        },
        {
          "description": "`pm unhide --user 0 <pkg>` — reverses Hide.",
          "type": "string",
          "const": "unhide"
        },
        {
          "description": "`pm disable-user --user 0 <pkg>` — reversible with `pm enable`.",
          "type": "string",
          "const": "disable"
        },
        {
          "description": "`pm enable <pkg>` — reverses Disable.",
          "type": "string",
          "const": "enable"
        },
        {
          "description": "`pm disable-until-used --user 0 <pkg>` — moves a package into the\nplatform's lazy-disabled state. The verified inverse is DefaultState.",
          "type": "string",
          "const": "disable_until_used"
        },
        {
          "description": "`pm default-state --user 0 <pkg>` — restores a package from the\nverified disabled-until-used state to its manifest default.",
          "type": "string",
          "const": "default_state"
        },
        {
          "description": "`pm suspend-quarantine --user 0 <pkg>` — the quarantine-flavoured\nsuspension command. AOSP currently does not publish this command in\n`pm help`, so it is only available when the device advertises it.",
          "type": "string",
          "const": "suspend_quarantine"
        },
        {
          "description": "Android 15+ `pm archive` keeps user data while removing APK/cache.",
          "type": "string",
          "const": "archive"
        },
        {
          "description": "Android 15+ `pm request-unarchive` asks the responsible installer to\nrestore an archived package.",
          "type": "string",
          "const": "request_unarchive"
        },
        {
          "description": "`pm uninstall --user 0 <pkg>` — effectively permanent for the\ncurrent user; the APK remains in `/system/` (system apps) but\nis removed from `/data/app/` (user apps).",
          "type": "string",
          "const": "uninstall_for_user"
        },
        {
          "description": "Backend-only inverse for a verified retained system package.\n`cmd package install-existing` is followed by an explicit restoration\nand verification of the prior enabled state.",
          "type": "string",
          "const": "restore_existing_for_user"
        },
        {
          "description": "`pm clear <pkg>` — wipes the package's data and cache.",
          "type": "string",
          "const": "clear_data"
        },
        {
          "description": "`am force-stop <pkg>` — non-destructive; included for symmetry.",
          "type": "string",
          "const": "force_stop"
        },
        {
          "description": "`pm grant --user <id> <pkg> <permission>`.",
          "type": "string",
          "const": "grant_permission"
        },
        {
          "description": "`pm revoke --user <id> <pkg> <permission>`.",
          "type": "string",
          "const": "revoke_permission"
        },
        {
          "description": "A reviewed arbitrary shell mutation. Read-only shell commands use the\nseparate `shell_run` path and never enter the mutation journal.",
          "type": "string",
          "const": "shell"
        }
      ]
    }
  },
  "$id": "https://github.com/SysAdminDoc/Droidsmith/blob/master/profiles/schema.json",
  "x-droidsmith-document-version": "3"
}
