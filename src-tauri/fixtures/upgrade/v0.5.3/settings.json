{
  "version": "1",
  "legacyImportComplete": true,
  "language": "ru",
  "mirrorPresets": {
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": {
      "maxSize": "1920",
      "bitRate": "12M",
      "noAudio": false,
      "recording": false,
      "keyboardMode": "uhid",
